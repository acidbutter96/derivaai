ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Shared Postgres from devbutter_app/infra (host port POSTGRES_HOST_PORT, default 5436). DATABASE_URL is ignored.
DATABASE_HOST=localhost
DATABASE_PORT=5436
DATABASE_USER=derivaai
DATABASE_PASSWORD=derivaai
DATABASE_NAME=derivaai
# Shared Redis from devbutter_app/infra; each app consumes only its own queue.
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=derivaai-renders
CELERY_TASK_ALWAYS_EAGER=false
STORAGE_DIR=./storage
